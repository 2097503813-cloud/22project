# model_service 的本地数据库配置（示例）
#
# 用法：复制成同目录下的 db.env，填入真实值即可，服务启动时会自动读取；
# 若同名环境变量已存在，则以环境变量为准（便于临时覆盖）。
# 注意：db.env 含明文口令，不要提交到版本库 / 不要外发。

MODEL_DB_DIALECT=mysql
MODEL_DB_HOST=127.0.0.1
MODEL_DB_PORT=3306
MODEL_DB_USER=你的MySQL账号
MODEL_DB_PASSWORD=你的MySQL口令
MODEL_DB_NAME=model_management

# 若改用 SQL Server（需先装官方 ODBC Driver 17/18）：
#   MODEL_DB_DIALECT=sqlserver
#   MODEL_DB_HOST=127.0.0.1      # 命名实例写成 .\SQLEXPRESS，此时端口留空
#   MODEL_DB_PORT=1433
#   MODEL_DB_USER=sa
#   MODEL_DB_PASSWORD=***
#   MODEL_DB_TRUSTED=1           # 用 Windows 信任连接时设置，此时无需账号口令
#
# 什么都不配则默认走 SQLite 兜底库 data/model_management.db
